# Student Navigator — Backend Configuration Template
# Copy this file to '.env' and populate with actual credentials

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=replace-with-your-groq-api-key
CLIENT_URL=http://localhost:5173

# Centralized CORS whitelist (comma-separated origins for production)
# CLIENT_URL=https://student-navigator-client.vercel.app

# Optional SMTP Configuration (Falls back to Ethereal/Mock logging if blank)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_NAME=
FROM_EMAIL=
